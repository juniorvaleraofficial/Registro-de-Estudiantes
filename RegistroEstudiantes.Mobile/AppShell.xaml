<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RegistroEstudiantes.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:RegistroEstudiantes.Mobile.Views"
    Title="Registro de Estudiantes">

	<ShellContent
        Title="Login"
        Route="login"
        ContentTemplate="{DataTemplate views:LoginPage}" />

	<ShellContent
        Title="Principal"
        Route="home"
        ContentTemplate="{DataTemplate views:HomePage}" />

	<ShellContent
        Title="Estudiantes"
        Route="students"
        ContentTemplate="{DataTemplate views:StudentsPage}" />

	<ShellContent
        Title="Formulario"
        Route="student-form"
        ContentTemplate="{DataTemplate views:StudentFormPage}" />

</Shell>