<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RegistroEstudiantes.Mobile.Views.AsistenciasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F4F6F8"
    Title="Asistencias">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label
                Text="Asistencias"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#111827" />

            <Label
                Text="Registra la asistencia de los estudiantes por materia."
                FontSize="16"
                TextColor="#6B7280" />

            <Border
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                Padding="20">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Nueva asistencia"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#111827" />

                    <Picker
                        Title="Selecciona un estudiante"
                        ItemsSource="{Binding EstudiantesOpciones}"
                        SelectedItem="{Binding EstudianteSeleccionado}"
                        BackgroundColor="#F9FAFB" />

                    <Label
                        Text="{Binding EstudianteError}"
                        FontSize="13"
                        TextColor="#DC2626"
                        IsVisible="{Binding TieneErrorEstudiante}" />

                    <Picker
                        Title="Selecciona una materia"
                        ItemsSource="{Binding MateriasOpciones}"
                        SelectedItem="{Binding MateriaSeleccionada}"
                        BackgroundColor="#F9FAFB" />

                    <Label
                        Text="{Binding MateriaError}"
                        FontSize="13"
                        TextColor="#DC2626"
                        IsVisible="{Binding TieneErrorMateria}" />

                    <DatePicker
                        Date="{Binding Fecha}"
                        BackgroundColor="#F9FAFB" />

                    <Label
                        Text="{Binding FechaError}"
                        FontSize="13"
                        TextColor="#DC2626"
                        IsVisible="{Binding TieneErrorFecha}" />

                    <Picker
                        Title="Estado de asistencia"
                        ItemsSource="{Binding EstadosOpciones}"
                        SelectedItem="{Binding EstadoSeleccionado}"
                        BackgroundColor="#F9FAFB" />

                    <Label
                        Text="{Binding EstadoError}"
                        FontSize="13"
                        TextColor="#DC2626"
                        IsVisible="{Binding TieneErrorEstado}" />

                    <Button
                        Text="Guardar asistencia"
                        Command="{Binding GuardarAsistenciaCommand}"
                        BackgroundColor="#4F46E5"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50" />

                    <Button
                        Text="Limpiar formulario"
                        Command="{Binding LimpiarFormularioCommand}"
                        BackgroundColor="#111827"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="48" />

                </VerticalStackLayout>
            </Border>

            <Label
                Text="Listado de asistencias"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="#111827" />

            <CollectionView
                ItemsSource="{Binding Asistencias}"
                EmptyView="No hay asistencias registradas todavía.">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            Padding="16"
                            Margin="0,0,0,12">

                            <VerticalStackLayout Spacing="6">

                                <Label
                                    Text="{Binding Estudiante}"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="#111827" />

                                <Label
                                    Text="{Binding Materia}"
                                    FontSize="14"
                                    TextColor="#4B5563" />

                                <Label
                                    Text="{Binding Fecha, StringFormat='Fecha: {0:dd/MM/yyyy}'}"
                                    FontSize="14"
                                    TextColor="#4B5563" />

                                <Label
                                    Text="{Binding Estado}"
                                    FontSize="14"
                                    TextColor="#4F46E5"
                                    FontAttributes="Bold" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>