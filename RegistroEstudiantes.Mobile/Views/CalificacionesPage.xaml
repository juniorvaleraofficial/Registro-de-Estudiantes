<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RegistroEstudiantes.Mobile.Views.CalificacionesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F4F6F8"
    Title="Calificaciones">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label
                Text="Calificaciones"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#111827" />

            <Label
                Text="Registra las calificaciones de los estudiantes por materia."
                FontSize="16"
                TextColor="#6B7280" />

            <Border
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                Padding="20">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Nueva calificación"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#111827" />

                    <Picker
                        x:Name="EstudiantePicker"
                        Title="Selecciona un estudiante"
                        BackgroundColor="#F9FAFB" />

                    <Picker
                        x:Name="MateriaPicker"
                        Title="Selecciona una materia"
                        BackgroundColor="#F9FAFB" />

                    <Entry
                        x:Name="NotaEntry"
                        Placeholder="Nota de 0 a 100"
                        Keyboard="Numeric"
                        BackgroundColor="#F9FAFB" />

                    <Entry
                        x:Name="ObservacionEntry"
                        Placeholder="Observación"
                        BackgroundColor="#F9FAFB" />

                    <Label
                        x:Name="MensajeLabel"
                        Text=""
                        FontSize="14"
                        TextColor="#DC2626"
                        IsVisible="False" />

                    <Button
                        Text="Guardar calificación"
                        BackgroundColor="#4F46E5"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50"
                        Clicked="OnGuardarCalificacionClicked" />

                    <Button
                        Text="Limpiar formulario"
                        BackgroundColor="#111827"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="48"
                        Clicked="OnLimpiarFormularioClicked" />

                </VerticalStackLayout>
            </Border>

            <Label
                Text="Listado de calificaciones"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="#111827" />

            <CollectionView
                x:Name="CalificacionesCollectionView"
                EmptyView="No hay calificaciones registradas todavía.">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            Padding="16"
                            Margin="0,0,0,12">

                            <VerticalStackLayout Spacing="6">

                                <Label
                                    Text="{Binding Estudiante}"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="#111827" />

                                <Label
                                    Text="{Binding Materia}"
                                    FontSize="14"
                                    TextColor="#4B5563" />

                                <Label
                                    Text="{Binding Nota, StringFormat='Nota: {0}'}"
                                    FontSize="14"
                                    TextColor="#4F46E5"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding Observacion}"
                                    FontSize="14"
                                    TextColor="#4B5563" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>