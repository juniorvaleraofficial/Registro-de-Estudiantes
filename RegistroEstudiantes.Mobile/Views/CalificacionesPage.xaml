<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RegistroEstudiantes.Mobile.Views.CalificacionesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F4F6F8"
    Title="Calificaciones">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label
                Text="Calificaciones"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#111827" />

            <Label
                Text="Aquí se registrarán las calificaciones de los estudiantes."
                FontSize="16"
                TextColor="#6B7280" />

            <Border
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                Padding="20">

                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Módulo en preparación"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#111827" />

                    <Label
                        Text="En el siguiente bloque agregaremos el formulario y el listado de calificaciones."
                        FontSize="15"
                        TextColor="#4B5563" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>