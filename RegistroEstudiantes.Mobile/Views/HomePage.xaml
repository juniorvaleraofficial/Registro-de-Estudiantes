<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RegistroEstudiantes.Mobile.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F4F6F8"
    Title="Inicio">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label
                Text="Panel principal"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#111827" />

            <Label
                Text="Sistema móvil para control académico básico."
                FontSize="16"
                TextColor="#6B7280" />

            <Border
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                Padding="20">

                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Unidad 3"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#111827" />

                    <Label
                        Text="Esta aplicación permite registrar estudiantes, materias, asistencias y calificaciones usando datos temporales en memoria."
                        FontSize="15"
                        TextColor="#4B5563" />
                </VerticalStackLayout>
            </Border>

            <Button
                Text="Estudiantes"
                BackgroundColor="#4F46E5"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="50"
                Clicked="OnEstudiantesClicked" />

            <Button
                Text="Materias"
                BackgroundColor="#111827"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="50"
                Clicked="OnMateriasClicked" />

            <Button
                Text="Asistencias"
                BackgroundColor="#111827"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="50"
                Clicked="OnAsistenciasClicked" />

            <Button
                Text="Calificaciones"
                BackgroundColor="#111827"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="50"
                Clicked="OnCalificacionesClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>