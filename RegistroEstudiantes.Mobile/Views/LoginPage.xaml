<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RegistroEstudiantes.Mobile.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F4F6F8"
    Title="Login">

    <Grid Padding="24">
        <Border
            BackgroundColor="White"
            Stroke="#E5E7EB"
            StrokeThickness="1"
            Padding="28"
            VerticalOptions="Center">

            <VerticalStackLayout Spacing="14">

                <Label
                    Text="Control Académico Estudiantil"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="#111827"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Acceso al sistema académico"
                    FontSize="16"
                    TextColor="#6B7280"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center" />

                <Entry
                    Placeholder="Usuario"
                    Text="{Binding Usuario}"
                    BackgroundColor="#F9FAFB"
                    Keyboard="Text" />

                <Label
                    Text="{Binding UsuarioError}"
                    FontSize="13"
                    TextColor="#DC2626"
                    IsVisible="{Binding TieneErrorUsuario}" />

                <Entry
                    Placeholder="Contraseña"
                    Text="{Binding Contrasena}"
                    IsPassword="True"
                    BackgroundColor="#F9FAFB" />

                <Label
                    Text="{Binding ContrasenaError}"
                    FontSize="13"
                    TextColor="#DC2626"
                    IsVisible="{Binding TieneErrorContrasena}" />

                <Button
                    Text="Entrar"
                    Command="{Binding IniciarSesionCommand}"
                    BackgroundColor="#4F46E5"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50" />

                <Label
                    Text="Usuario de prueba: admin   |   Clave: 1234"
                    FontSize="13"
                    TextColor="#6B7280"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Proyecto académico - Unidad 6"
                    FontSize="13"
                    TextColor="#9CA3AF"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>