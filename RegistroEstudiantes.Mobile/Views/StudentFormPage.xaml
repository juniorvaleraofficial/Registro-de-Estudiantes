<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RegistroEstudiantes.Mobile.Views.StudentFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Formulario">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="14">
            <Label
                Text="Formulario de estudiante"
                FontSize="28"
                FontAttributes="Bold" />

            <Entry Placeholder="Nombre" />
            <Entry Placeholder="Apellido" />
            <Entry Placeholder="Matrícula" />
            <Entry Placeholder="Correo electrónico" Keyboard="Email" />
            <Entry Placeholder="Teléfono" Keyboard="Telephone" />
            <Entry Placeholder="Carrera" />

            <DatePicker />

            <Picker Title="Estado">
                <Picker.Items>
                    <x:String>Activo</x:String>
                    <x:String>Inactivo</x:String>
                </Picker.Items>
            </Picker>

            <Button Text="Guardar estudiante" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>