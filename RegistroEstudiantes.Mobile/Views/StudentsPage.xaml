<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="RegistroEstudiantes.Mobile.Views.StudentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:RegistroEstudiantes.Mobile.Views"
    BackgroundColor="#F5F6F8"
    Title="Estudiantes">

    <CollectionView
        ItemsSource="{Binding Estudiantes}"
        SelectionMode="None">

        <!-- ============================================= -->
        <!-- ENCABEZADO Y FORMULARIO                       -->
        <!-- ============================================= -->

        <CollectionView.Header>

            <VerticalStackLayout Spacing="18">

                <!-- Encabezado principal -->

                <Border
                    BackgroundColor="#720C16"
                    Padding="24,26,24,28"
                    StrokeThickness="0">

                    <VerticalStackLayout Spacing="7">

                        <Label
                            Text="CONTROL ACADÉMICO"
                            FontSize="12"
                            FontAttributes="Bold"
                            CharacterSpacing="1.4"
                            TextColor="#F4D5D8" />

                        <Label
                            Text="Estudiantes"
                            FontSize="32"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="Registra, consulta, edita y elimina la información de los estudiantes."
                            FontSize="15"
                            LineHeight="1.2"
                            TextColor="#F8E7E9" />

                    </VerticalStackLayout>
                </Border>

                <!-- Tarjeta del formulario -->

                <Border
                    Margin="20,0"
                    Padding="20"
                    BackgroundColor="White"
                    Stroke="#E3E5E8"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="14">

                        <!-- Título dinámico -->

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="3">

                                <Label
                                    Text="{Binding TituloFormulario}"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    TextColor="#171A21" />

                                <Label
                                    Text="Completa los datos solicitados."
                                    FontSize="14"
                                    TextColor="#747A86" />

                            </VerticalStackLayout>

                            <Border
                                Grid.Column="1"
                                Padding="10,5"
                                BackgroundColor="#FFF1F2"
                                Stroke="#F5C2C7"
                                StrokeThickness="1"
                                IsVisible="{Binding EsModoEdicion}"
                                VerticalOptions="Start">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>

                                <Label
                                    Text="Editando"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#A61120" />

                            </Border>

                        </Grid>

                        <!-- Matrícula -->

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="Matrícula"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#343944" />

                            <Border
                                Padding="12,2"
                                BackgroundColor="#F8F9FA"
                                Stroke="#DDE0E5"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Entry
                                    Placeholder="Ejemplo: MT-2023-00518"
                                    Text="{Binding Matricula, Mode=TwoWay}"
                                        BackgroundColor="Transparent"
                                    TextColor="#171A21"
                                    PlaceholderColor="#9AA0AA" />

                            </Border>

                            <Label
                                Text="{Binding MatriculaError}"
                                FontSize="13"
                                TextColor="#C62828"
                                IsVisible="{Binding TieneErrorMatricula}" />

                        </VerticalStackLayout>

                        <!-- Nombre -->

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="Nombre"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#343944" />

                            <Border
                                Padding="12,2"
                                BackgroundColor="#F8F9FA"
                                Stroke="#DDE0E5"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Entry
                                    Placeholder="Nombre del estudiante"
                                    Text="{Binding Nombre, Mode=TwoWay}"
                                    ClearButtonVisibility="WhileEditing"
                                    BackgroundColor="Transparent"
                                    TextColor="#171A21"
                                    PlaceholderColor="#9AA0AA" />

                            </Border>

                            <Label
                                Text="{Binding NombreError}"
                                FontSize="13"
                                TextColor="#C62828"
                                IsVisible="{Binding TieneErrorNombre}" />

                        </VerticalStackLayout>

                        <!-- Apellido -->

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="Apellido"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#343944" />

                            <Border
                                Padding="12,2"
                                BackgroundColor="#F8F9FA"
                                Stroke="#DDE0E5"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Entry
                                    Placeholder="Apellido del estudiante"
                                    Text="{Binding Apellido, Mode=TwoWay}"
                                    ClearButtonVisibility="WhileEditing"
                                    BackgroundColor="Transparent"
                                    TextColor="#171A21"
                                    PlaceholderColor="#9AA0AA" />

                            </Border>

                            <Label
                                Text="{Binding ApellidoError}"
                                FontSize="13"
                                TextColor="#C62828"
                                IsVisible="{Binding TieneErrorApellido}" />

                        </VerticalStackLayout>

                        <!-- Carrera -->

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="Carrera"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#343944" />

                            <Border
                                Padding="12,2"
                                BackgroundColor="#F8F9FA"
                                Stroke="#DDE0E5"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Entry
                                    Placeholder="Carrera que cursa"
                                    Text="{Binding Carrera, Mode=TwoWay}"
                                    ClearButtonVisibility="WhileEditing"
                                    BackgroundColor="Transparent"
                                    TextColor="#171A21"
                                    PlaceholderColor="#9AA0AA" />

                            </Border>

                            <Label
                                Text="{Binding CarreraError}"
                                FontSize="13"
                                TextColor="#C62828"
                                IsVisible="{Binding TieneErrorCarrera}" />

                        </VerticalStackLayout>

                        <!-- Teléfono -->

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="Teléfono"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#343944" />

                            <Border
                                Padding="12,2"
                                BackgroundColor="#F8F9FA"
                                Stroke="#DDE0E5"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Entry
                                    Placeholder="809-000-0000"
                                    Text="{Binding Telefono, Mode=TwoWay}"
                                    Keyboard="Telephone"
                                    ClearButtonVisibility="WhileEditing"
                                    BackgroundColor="Transparent"
                                    TextColor="#171A21"
                                    PlaceholderColor="#9AA0AA" />

                            </Border>

                            <Label
                                Text="{Binding TelefonoError}"
                                FontSize="13"
                                TextColor="#C62828"
                                IsVisible="{Binding TieneErrorTelefono}" />

                        </VerticalStackLayout>

                        <!-- Botón guardar -->

                        <Button
                            Text="{Binding TextoBotonGuardar}"
                            Command="{Binding GuardarEstudianteCommand}"
                            Margin="0,6,0,0"
                            HeightRequest="52"
                            BackgroundColor="#720C16"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="12" />

                        <!-- Botón limpiar o cancelar -->

                        <Button
                            Text="{Binding TextoBotonSecundario}"
                            Command="{Binding LimpiarFormularioCommand}"
                            HeightRequest="50"
                            BackgroundColor="#ECEEF1"
                            TextColor="#272B34"
                            FontAttributes="Bold"
                            CornerRadius="12" />

                        <!-- Botón eliminar del formulario -->

                        <Button
                            Text="Eliminar estudiante"
                            Command="{Binding EliminarEstudianteActualCommand}"
                            IsVisible="{Binding MostrarBotonEliminar}"
                            HeightRequest="50"
                            BackgroundColor="#FFF0F1"
                            TextColor="#B4232D"
                            BorderColor="#E5A2A8"
                            BorderWidth="1"
                            FontAttributes="Bold"
                            CornerRadius="12" />

                    </VerticalStackLayout>

                </Border>

                <!-- Buscador de estudiantes -->

                <Border
                    Margin="20,0"
                    Padding="16"
                    BackgroundColor="White"
                    Stroke="#E0E3E7"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">

                        <Label
                            Text="Buscar estudiantes"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#343944" />

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">

                            <SearchBar
                                Placeholder="Nombre, apellido, matrícula o carrera"
                                Text="{Binding TextoBusqueda, Mode=TwoWay}"
                                BackgroundColor="#F8F9FA"
                                PlaceholderColor="#8A909A"
                                TextColor="#171A21" />

                            <Button
                                Grid.Column="1"
                                Text="Limpiar"
                                Command="{Binding LimpiarBusquedaCommand}"
                                IsVisible="{Binding TieneBusquedaActiva}"
                                Padding="14,0"
                                HeightRequest="50"
                                VerticalOptions="Center"
                                BackgroundColor="#F1E7E8"
                                TextColor="#720C16"
                                FontAttributes="Bold"
                                CornerRadius="12" />

                        </Grid>

                        <Label
                            Text="Los resultados se actualizan mientras escribes."
                            FontSize="12"
                            TextColor="#747A86" />

                    </VerticalStackLayout>

                </Border>

                <!-- Encabezado del listado -->

                <Grid
                    Margin="20,4,20,0"
                    ColumnDefinitions="*,Auto">

                    <VerticalStackLayout Spacing="2">

                        <Label
                            Text="Estudiantes registrados"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="#171A21" />

                        <Label
                            Text="Toca una tarjeta para editar sus datos."
                            FontSize="14"
                            TextColor="#747A86" />

                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        Padding="10,5"
                        BackgroundColor="#F1E7E8"
                        StrokeThickness="0"
                        VerticalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Label
                            Text="{Binding TextoCantidadEstudiantes}"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="#720C16" />

                    </Border>

                </Grid>

            </VerticalStackLayout>

        </CollectionView.Header>

        <!-- ============================================= -->
        <!-- LISTA DE ESTUDIANTES                          -->
        <!-- ============================================= -->

        <CollectionView.ItemTemplate>

            <DataTemplate>

                <Border
                    Margin="20,12,20,0"
                    Padding="17"
                    BackgroundColor="White"
                    Stroke="#E0E3E7"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>

                        <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type views:StudentsPage}}, Path=BindingContext.SeleccionarEstudianteCommand}"
                            CommandParameter="{Binding .}" />

                    </Border.GestureRecognizers>

                    <Grid
                        RowDefinitions="Auto,Auto"
                        ColumnDefinitions="*,Auto"
                        RowSpacing="12"
                        ColumnSpacing="12">

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="{Binding NombreCompleto}"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="#171A21"
                                LineBreakMode="TailTruncation" />

                            <Label
                                Text="{Binding Matricula}"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#720C16" />

                            <Label
                                Text="{Binding Carrera}"
                                FontSize="14"
                                TextColor="#555C68"
                                LineBreakMode="TailTruncation" />

                            <Label
                                Text="{Binding Telefono}"
                                FontSize="14"
                                TextColor="#747A86" />

                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="Eliminar"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type views:StudentsPage}}, Path=BindingContext.EliminarEstudianteDesdeListaCommand}"
                            CommandParameter="{Binding .}"
                            Padding="13,8"
                            MinimumHeightRequest="38"
                            VerticalOptions="Start"
                            BackgroundColor="#FFF0F1"
                            TextColor="#B4232D"
                            BorderColor="#EDB4B9"
                            BorderWidth="1"
                            FontSize="12"
                            FontAttributes="Bold"
                            CornerRadius="10" />

                        <Label
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Text="Toca esta tarjeta para cargar el registro en el formulario."
                            FontSize="12"
                            TextColor="#8A909A" />

                    </Grid>

                </Border>

            </DataTemplate>

        </CollectionView.ItemTemplate>

        <!-- Mensaje cuando no existan registros -->

        <CollectionView.EmptyView>

            <Border
                Margin="20,18,20,30"
                Padding="24"
                BackgroundColor="White"
                Stroke="#E0E3E7"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="{Binding TituloListaVacia}"
                        HorizontalTextAlignment="Center"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#343944" />

                    <Label
                        Text="{Binding MensajeListaVacia}"
                        HorizontalTextAlignment="Center"
                        FontSize="14"
                        TextColor="#747A86" />

                </VerticalStackLayout>

            </Border>

        </CollectionView.EmptyView>

        <CollectionView.Footer>

            <BoxView
                HeightRequest="30"
                Color="Transparent" />

        </CollectionView.Footer>

    </CollectionView>

</ContentPage>